# Copy to `.env` and fill in. Never commit the real `.env`.
#
# These are the ONLY three credentials run_poc.py reads, and it reads them
# exclusively from the environment. They are never logged, never written to
# results, and are redacted from any error text.

# NVIDIA API key for the hosted OpenAI-compatible endpoint
# (https://integrate.api.nvidia.com/v1). Get one at https://build.nvidia.com.
#
# !! NOTE !! An existing .env in this directory uses the name `NVIDIA-KEY`.
# That is not a valid shell identifier and is not the name the POC spec
# mandates. Rename it to NVIDIA_API_KEY.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TypeSafe AI API key for the System One (Jev) judge.
# Get one from the dashboard: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional. naver-clova-ix/cord-v2 is a public, ungated dataset, so this is
# NOT required. Set it only if you hit Hugging Face rate limits.
HF_TOKEN=
